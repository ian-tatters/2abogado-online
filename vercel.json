{
  "redirects": [
    { "source": "/usuario", "destination": "/notaria", "permanent": false },
    { "source": "/usuario/", "destination": "/notaria", "permanent": false },
    { "source": "/usuario/:path*", "destination": "/notaria/:path*", "permanent": false },
    { "source": "/notaria/", "destination": "/notaria", "permanent": true },
    { "source": "/notaria:n(\\d{1,4})", "destination": "/notaria/entrar?n=:n", "permanent": false },
    { "source": "/notaria:n(\\d{1,4})/", "destination": "/notaria/entrar?n=:n", "permanent": false },
    { "source": "/testamento/gracias.html", "destination": "/gracias/?t=testamento", "permanent": false },
    { "source": "/:ruta((?!usuario(?:/|$)|notaria\\d*(?:/|$)|api/)(?:[^/]+/)*[^/.]+)", "destination": "/:ruta/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/notaria", "destination": "https://app-notarias.vercel.app/notaria" },
    { "source": "/notaria/:path*", "destination": "https://app-notarias.vercel.app/notaria/:path*" },
    { "source": "/api/generar", "destination": "https://app-notarias.vercel.app/api/generar" }
  ]
}
